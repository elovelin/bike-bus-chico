# Local staging only. Leave SHOP_STAGED unset in ordinary production builds.
SHOP_STAGED=1

# All four values below are required together to connect real products.
# Storefront token from Fourthwall Settings > For developers (not a Platform API key).
FOURTHWALL_STOREFRONT_TOKEN=
# Your existing HTTPS https://<shop>.fourthwall.com origin, with no path.
FOURTHWALL_SHOP_URL=
# Actual published product IDs, not variant IDs.
FOURTHWALL_DAD_HAT_PRODUCT_ID=
FOURTHWALL_TEE_PRODUCT_ID=
