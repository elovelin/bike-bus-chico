<section class="promo-band" aria-label="Bike Bus Chico in motion">
  <div class="promo-inner">
    <video
      id="promo-video"
      aria-label="Bike Bus Chico promo: families riding together"
      width="1920"
      height="1080"
      poster="/media/bike-bus-promo-poster-v2.jpg"
      controls
      controlslist="nodownload"
      muted
      playsinline
      loop
      preload="none"
      data-small-src="/media/bike-bus-promo-720p-v2.mp4"
      data-large-src="/media/bike-bus-promo-1080p-v2.mp4"
    >
      <source src="/media/bike-bus-promo-720p-v2.mp4" type="video/mp4" media="(max-width: 760px)" />
      <source src="/media/bike-bus-promo-1080p-v2.mp4" type="video/mp4" />
      <p>Your browser cannot play this video.</p>
    </video>
    <div class="promo-controls" role="group" aria-label="Video controls" hidden>
      <button type="button" data-play aria-label="Play video" title="Play video" aria-controls="promo-video" aria-pressed="false">
        <svg class="icon-play" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="m8 5 11 7-11 7V5Z" fill="currentColor" /></svg>
        <svg class="icon-pause" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M6 5h4v14H6zm8 0h4v14h-4z" fill="currentColor" /></svg>
      </button>
      <button type="button" data-sound aria-label="Sound on" title="Sound on" aria-controls="promo-video" aria-pressed="false">
        <svg class="icon-muted" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="m11 5-5 4H3v6h3l5 4V5Z" fill="currentColor" /><path d="m16 9 5 6m0-6-5 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <svg class="icon-audible" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="m11 5-5 4H3v6h3l5 4V5Z" fill="currentColor" /><path d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
  <p class="promo-status" role="status" aria-live="polite"></p>
</section>

<script>
  interface Connection extends EventTarget {
    saveData?: boolean;
    effectiveType?: string;
    downlink?: number;
  }

  const video = document.querySelector<HTMLVideoElement>('#promo-video');
  const promo = document.querySelector<HTMLElement>('.promo-band');
  const controls = promo?.querySelector<HTMLElement>('.promo-controls');
  const playButton = promo?.querySelector<HTMLButtonElement>('[data-play]');
  const soundButton = promo?.querySelector<HTMLButtonElement>('[data-sound]');
  const status = promo?.querySelector<HTMLElement>('.promo-status');

  if (video && controls && playButton && soundButton && status && 'IntersectionObserver' in window) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const narrow = window.matchMedia('(max-width: 760px)');
    const connection = (navigator as Navigator & { connection?: Connection }).connection;
    let intent: 'auto' | 'play' | 'pause' = 'auto';
    let manualPermission = false;
    let visible = false;
    let pending = false;
    let failed = false;
    let attempt = 0;
    let resumeAt = 0;
    const cleanup = new AbortController();
    const options = { signal: cleanup.signal };

    const dataRestricted = () => connection?.saveData === true ||
      ['slow-2g', '2g', '3g'].includes(connection?.effectiveType ?? '') ||
      (connection?.downlink !== undefined && connection.downlink > 0 && connection.downlink < 1);
    const restricted = () => motion.matches || dataRestricted();

    const syncControls = () => {
      const playLabel = video.paused ? 'Play video' : 'Pause video';
      playButton.setAttribute('aria-label', playLabel);
      playButton.title = playLabel;
      playButton.setAttribute('aria-pressed', String(!video.paused));
      const audible = !video.muted && video.volume > 0;
      const soundLabel = audible ? 'Sound off' : 'Sound on';
      soundButton.setAttribute('aria-label', soundLabel);
      soundButton.title = soundLabel;
      soundButton.setAttribute('aria-pressed', String(audible));
    };

    const reportFailure = (error: unknown) => {
      failed = true;
      status.textContent = 'The video could not load. Press Play to try again.';
      console.error('Bike Bus promo video failed to load or play:', error);
      syncControls();
    };

    const pause = () => {
      attempt++;
      pending = false;
      video.pause();
      syncControls();
    };

    const start = async () => {
      if (pending) return;
      const source = narrow.matches || dataRestricted() ? video.dataset.smallSrc : video.dataset.largeSrc;
      if (!source) {
        reportFailure(new Error('Missing promo video source.'));
        return;
      }
      if (!video.paused && video.getAttribute('src') === source) return;
      if (video.getAttribute('src') !== source) {
        resumeAt = video.currentTime;
        pause();
        video.querySelectorAll('source').forEach((element) => element.remove());
        video.src = source;
      }
      if (failed) {
        failed = false;
        video.load();
      }
      const currentAttempt = ++attempt;
      pending = true;
      try {
        await video.play();
      } catch (error) {
        if (currentAttempt !== attempt) return;
        if (error instanceof DOMException && error.name === 'NotAllowedError') {
          intent = 'pause';
          status.textContent = 'Press Play to watch the video. Sound stays off until you turn it on.';
        } else if (!(error instanceof DOMException && error.name === 'AbortError')) {
          reportFailure(error);
        }
      } finally {
        if (currentAttempt === attempt) {
          pending = false;
          syncControls();
        }
      }
    };

    const reconcile = () => {
      if (!visible || document.hidden || intent === 'pause' || failed ||
          (restricted() && !manualPermission)) {
        pause();
      } else {
        void start();
      }
    };

    const togglePlayback = () => {
      if (!video.paused || pending) {
        intent = 'pause';
        manualPermission = false;
        status.textContent = '';
        pause();
      } else {
        intent = 'play';
        manualPermission = true;
        status.textContent = '';
        void start();
      }
    };
    playButton.addEventListener('click', (event) => {
      event.stopPropagation();
      togglePlayback();
    }, options);
    video.addEventListener('click', togglePlayback, options);

    soundButton.addEventListener('click', (event) => {
      event.stopPropagation();
      video.muted = !video.muted;
      if (!video.muted && video.volume === 0) video.volume = 1;
      syncControls();
    }, options);

    for (const event of ['play', 'pause', 'volumechange', 'ended']) {
      video.addEventListener(event, syncControls, options);
    }
    video.addEventListener('loadedmetadata', () => {
      if (resumeAt > 0) {
        video.currentTime = Math.min(resumeAt, video.duration);
        resumeAt = 0;
      }
    }, options);
    video.addEventListener('playing', () => { status.textContent = ''; }, options);
    video.addEventListener('error', () => reportFailure(video.error), options);
    const preferencesChanged = () => {
      manualPermission = false;
      if (restricted()) status.textContent = 'Autoplay is off for your motion or data preferences. Press Play to watch.';
      else if (!failed) status.textContent = '';
      reconcile();
    };
    motion.addEventListener('change', preferencesChanged, options);
    connection?.addEventListener('change', preferencesChanged, options);
    narrow.addEventListener('change', reconcile, options);
    document.addEventListener('visibilitychange', reconcile, options);
    window.addEventListener('pagehide', pause, options);
    window.addEventListener('pageshow', reconcile, options);
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting && entry.intersectionRatio >= 0.1;
      reconcile();
    }, { threshold: [0, 0.1] });

    syncControls();
    if (restricted()) status.textContent = 'Autoplay is off for your motion or data preferences. Press Play to watch.';
    observer.observe(video);
    controls.hidden = false;
    video.controls = false;
    video.classList.add('enhanced');
    // Keep the native baseline on browsers without enhancement; dispose for Astro navigation.
    document.addEventListener('astro:before-swap', () => {
      pause();
      observer.disconnect();
      cleanup.abort();
    }, { once: true, signal: cleanup.signal });
  }
</script>

<style>
  .promo-band { min-width: 0; }
  .promo-inner { position: relative; width: 100%; }
  video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: contain; background: var(--navy); }
  video.enhanced { cursor: pointer; }
  .promo-controls { position: absolute; right: 6px; bottom: 6px; display: flex; gap: 8px; padding: 4px; border-radius: 10px; background: rgba(18, 48, 110, .88); }
  .promo-controls[hidden] { display: none; }
  button { display: inline-flex; align-items: center; justify-content: center; cursor: pointer; width: 44px; height: 44px; min-width: 44px; min-height: 44px; padding: 8px; border: 0; border-radius: 6px; background: transparent; color: var(--cream); }
  button:hover { background: rgba(247, 242, 233, .15); }
  button:focus-visible { outline: 3px solid var(--orange); outline-offset: 1px; }
  .icon-pause, .icon-audible { display: none; }
  [data-play][aria-pressed="true"] .icon-play, [data-sound][aria-pressed="true"] .icon-muted { display: none; }
  [data-play][aria-pressed="true"] .icon-pause, [data-sound][aria-pressed="true"] .icon-audible { display: block; }
  .promo-status { font-size: 12px; margin: 10px 0 0; }
  .promo-status:empty { display: none; }
</style>
