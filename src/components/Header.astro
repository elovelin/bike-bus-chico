---
import { nav, headerCta, site } from '../data/site';
const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <img src="/brand/path3/logo.svg" width="236" height="91" alt={site.name} />
    </a>
    <button class="menu-toggle" type="button" aria-controls="primary-nav" aria-expanded="false">
      Menu <span aria-hidden="true">+</span>
    </button>
    <nav id="primary-nav" class="nav" aria-label="Main navigation">
      {nav.map((item) => (
        <a href={item.href} aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <a class="button button-small" href={headerCta.href}>{headerCta.label} <span aria-hidden="true">&#8599;</span></a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('primary-nav');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
      const mark = toggle.querySelector('span');
      if (mark) mark.textContent = open ? '-' : '+';
    };
    menu.classList.add('enhanced');
    toggle.classList.add('enhanced');
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
      }
    });
    toggle.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    window.matchMedia('(min-width: 761px)').addEventListener('change', () => setOpen(false));
  }
</script>
