---
interface Props {
  heading?: string;
  text?: string;
  label?: string;
  href?: string;
  wheelPattern?: boolean;
}
const {
  heading = 'Come meet the crew.',
  text = 'Find an existing ride, or start a Bike Bus at your own school.',
  label = 'Find your ride',
  href = '/routes/',
  wheelPattern = false,
} = Astro.props;
---

<section class:list={['closing', { 'closing-pattern': wheelPattern }]}>
  <div class="wrap closing-content">
    <div><h2>{heading}</h2><p>{text}</p></div>
    <a class="button button-light" href={href}>{label} <span aria-hidden="true">&#8599;</span></a>
  </div>
</section>
