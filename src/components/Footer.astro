---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-top">
    <div>
      <a href="/" aria-label={`${site.name} home`}><img class="footer-logo" src="/brand/path3/logo-reverse.svg" alt={site.name} width="236" height="91" /></a>
      <p>A community group ride.<br />Kids, families, and Chico.</p>
    </div>
    <div>
      <p class="eyebrow">Come along</p>
      <a href="/routes/">Find a Bike Bus</a>
      <a href="/ride/">Your first ride</a>
      <a href="/start-a-route/">Start a Bike Bus</a>
    </div>
    <div>
      <p class="eyebrow">Say hello</p>
      <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
      <a href="/about/">About Bike Bus Chico</a>
      <p class="footer-note">Joining a route? Contact its ride leader.</p>
    </div>
  </div>
  <div class="wrap footer-disclaimer">
    Bike Bus Chico is a volunteer, parent-led community effort. We're not a nonprofit,
    a school program, or a transportation provider — just neighbors riding to school together.
  </div>
  <div class="wrap footer-bottom"><span>{site.location}</span><span>&copy; {year} {site.name}</span></div>
</footer>
