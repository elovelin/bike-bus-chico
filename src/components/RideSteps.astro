---
const steps = [
  { title: 'Find your route.', text: "See which Bike Bus goes to your school. Check the stops and let your route leader know you're interested." },
  { title: 'Meet along the way.', text: 'Bring your bike and helmet. Start with the crew or join at a listed stop that works for your family.' },
  { title: 'Roll together.', text: 'Ride at a kid-friendly pace and arrive at school with the group. No registration required.' },
];
---
<ol class="steps-grid" role="list">
  {steps.map((step, index) => (
    <li class="step"><span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>
  ))}
</ol>
