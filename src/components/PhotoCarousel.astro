---
import type { GalleryPhoto } from '../data/gallery';

interface Props {
  photos: readonly GalleryPhoto[];
}

const { photos } = Astro.props;
---

<div class="photo-carousel" role="group" aria-roledescription="carousel" aria-label="Community ride photos">
  <div class="carousel-toolbar">
    <p id="gallery-instructions">Swipe or scroll to explore the ride.</p>
    <div class="carousel-controls" hidden>
      <button type="button" data-previous aria-controls="gallery-track" aria-disabled="true">Previous photos</button>
      <button type="button" data-next aria-controls="gallery-track" aria-disabled="false">Next photos</button>
      <p class="carousel-status" role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </div>
  <ul id="gallery-track" class="carousel-row" role="group" tabindex="0" aria-label="Community photos" aria-describedby="gallery-instructions">
    {photos.map((photo, index) => (
      <li class="carousel-slide" role="group" aria-roledescription="slide" aria-label={`Photo ${index + 1} of ${photos.length}`}>
        <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
      </li>
    ))}
  </ul>
</div>

<script>
  const carousel = document.querySelector<HTMLElement>('.photo-carousel');
  const track = carousel?.querySelector<HTMLElement>('.carousel-row');
  const slides = Array.from(carousel?.querySelectorAll<HTMLElement>('.carousel-slide') ?? []);
  const controls = carousel?.querySelector<HTMLElement>('.carousel-controls');
  const previous = carousel?.querySelector<HTMLButtonElement>('[data-previous]');
  const next = carousel?.querySelector<HTMLButtonElement>('[data-next]');
  const status = carousel?.querySelector<HTMLElement>('.carousel-status');

  if (track && controls && previous && next && status && slides.length > 0) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const cleanup = new AbortController();
    const options = { signal: cleanup.signal };
    let timer: ReturnType<typeof setTimeout>;

    const update = () => {
      const bounds = track.getBoundingClientRect();
      const visible = slides.map((slide, index) => {
        const rect = slide.getBoundingClientRect();
        const overlap = Math.min(bounds.right, rect.right) - Math.max(bounds.left, rect.left);
        return overlap >= rect.width / 2 ? index + 1 : 0;
      }).filter(Boolean);
      previous.setAttribute('aria-disabled', String(track.scrollLeft <= 2));
      next.setAttribute('aria-disabled', String(track.scrollLeft >= track.scrollWidth - track.clientWidth - 2));
      if (visible.length > 0) {
        const first = visible[0];
        const last = visible[visible.length - 1];
        status.textContent = first === last ? `Photo ${first} of ${slides.length}` : `Photos ${first} to ${last} of ${slides.length}`;
      }
    };

    const goTo = (left: number) => {
      track.scrollTo({ left, behavior: motion.matches ? 'auto' : 'smooth' });
    };
    const move = (direction: number) => {
      const positions = slides.map((slide) => slide.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft);
      const current = positions.reduce((best, position, index) =>
        Math.abs(position - track.scrollLeft) < Math.abs(positions[best] - track.scrollLeft) ? index : best, 0);
      const target = Math.max(0, Math.min(slides.length - 1, current + direction));
      goTo(positions[target]);
    };
    previous.addEventListener('click', () => {
      if (previous.getAttribute('aria-disabled') !== 'true') move(-1);
    }, options);
    next.addEventListener('click', () => {
      if (next.getAttribute('aria-disabled') !== 'true') move(1);
    }, options);
    track.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey) return;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        move(event.key === 'ArrowLeft' ? -1 : 1);
      } else if (event.key === 'Home' || event.key === 'End') {
        event.preventDefault();
        goTo(event.key === 'Home' ? 0 : track.scrollWidth - track.clientWidth);
      }
    }, options);
    track.addEventListener('scroll', () => {
      clearTimeout(timer);
      timer = setTimeout(update, 100);
    }, options);
    motion.addEventListener('change', () => {
      if (motion.matches) track.scrollTo({ left: track.scrollLeft, behavior: 'auto' });
    }, options);
    const observer = new ResizeObserver(update);
    observer.observe(track);
    controls.hidden = false;
    update();
    document.addEventListener('astro:before-swap', () => {
      clearTimeout(timer);
      observer.disconnect();
      cleanup.abort();
    }, { once: true, signal: cleanup.signal });
  }
</script>

<style>
  .carousel-toolbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; margin-bottom: 18px; }
  .carousel-toolbar p { font-size: 12px; margin: 0; }
  .carousel-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
  .carousel-controls[hidden] { display: none; }
  button { min-height: 44px; cursor: pointer; border: 1px solid var(--navy); border-radius: 7px; background: var(--cream); color: var(--navy); padding: 8px 14px; font-family: var(--label); font-size: 11px; }
  button:hover { background: var(--sidewalk); }
  button[aria-disabled="true"] { opacity: .5; cursor: default; }
  .carousel-status { min-width: 115px; }
  .carousel-row { display: flex; gap: 16px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; margin: 0; padding: 0 0 14px; list-style: none; }
  .carousel-row:focus-visible { outline: 3px solid var(--blue); outline-offset: 5px; }
  .carousel-slide { flex: 0 0 calc((100% - 32px) / 3); min-width: 0; scroll-snap-align: start; }
  .carousel-slide img { width: 100%; height: 360px; object-fit: contain; background: var(--sidewalk); border-radius: 12px; }
  @media (max-width: 1100px) {
    .carousel-slide { flex-basis: calc((100% - 16px) / 2); }
    .carousel-slide img { height: 320px; }
  }
  @media (max-width: 760px) {
    .carousel-slide { flex-basis: 88%; }
    .carousel-slide img { height: 310px; }
    .carousel-status { flex-basis: 100%; }
  }
</style>
