---
import { schools } from '../data/schools';
import { routes } from '../data/routes';
---
<div class="route-grid">
  {schools.map((school) => {
    const schoolRoutes = routes.filter((route) => route.schoolSlug === school.slug);
    return (
      <article class="school-card">
        <a class="school-link" href={`/schools/${school.slug}/`}>
          <img src={school.logo} alt="" width="1000" height="1000" loading="lazy" />
          <h3>{school.name}</h3>
        </a>
        <p class="eyebrow">{schoolRoutes.some((route) => route.status === 'active') ? 'Friday rides' : 'Starting soon · Not yet running'}</p>
        <p>{school.summary}</p>
        <a class="text-link" href={`/schools/${school.slug}/`}>Explore {schoolRoutes.length === 1 ? 'the route' : `${schoolRoutes.length} routes`} <span aria-hidden="true">&#8599;</span><span class="sr-only"> to {school.name}</span></a>
      </article>
    );
  })}
</div>
<div class="school-invite">
  <div><h3>Your school could be next.</h3><p>A few families and a regular ride are all it takes to begin.</p></div>
  <a class="text-link" href="/start-a-route/">Start a Bike Bus <span aria-hidden="true">&#8599;</span></a>
</div>
<style>
  .school-card { display: flex; flex-direction: column; align-items: flex-start; padding: 31px; border: 1px solid var(--sidewalk); border-radius: 14px; background: white; }
  .school-link { width: 100%; margin-bottom: 22px; }
  .school-link img { width: 100%; height: 200px; object-fit: contain; margin-bottom: 25px; }
  .school-link h3 { color: var(--blue); font-size: 37px; }
  .school-link:hover h3 { text-decoration: underline; }
  .school-card .eyebrow { margin-bottom: 12px; letter-spacing: .06em; }
  .school-card > .text-link { margin-top: auto; padding-top: 10px; }
  @media (max-width: 760px) { .school-card { padding: 24px; } .school-link h3 { font-size: 34px; } }
</style>
