---
import type { Route } from '../data/routes';
import RouteFacts from './RouteFacts.astro';
import RouteStatus from './RouteStatus.astro';
interface Props { route: Route }
const { route } = Astro.props;
const neighborhood = route.name.split(' → ')[0];
---
<article class="route-card">
  <div class="card-top"><RouteStatus status={route.status} /><span class="eyebrow">Chico Country Day</span></div>
  <h3><a href={`/routes/${route.slug}/`}>{neighborhood}</a></h3>
  <p class="destination">to {route.school}</p>
  <RouteFacts route={route} />
  <p>{route.summary}</p>
  <a class="text-link" href={`/routes/${route.slug}/`}>See stops &amp; ride details <span aria-hidden="true">&#8599;</span><span class="sr-only"> for {neighborhood}</span></a>
</article>
