---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommunityCTA from '../components/CommunityCTA.astro';
import { site } from '../data/site';
const steps = [
  { title: 'Find a few families.', text: 'You only need a handful to start. A couple of families riding together is already a Bike Bus.' },
  { title: 'Choose a comfortable route.', text: 'Pick streets and paths that feel calm and doable for kids — not the fastest way, the friendliest way.' },
  { title: 'Work backward from arrival.', text: 'Decide when you need to be at school, then set your start time and stops from there.' },
  { title: 'Test ride it at kid pace.', text: 'Ride the route yourself, slowly, and see how long it really takes with kids in mind.' },
  { title: 'Choose a consistent day.', text: 'A regular day — even just once a week — is what turns a ride into a Bike Bus.' },
  { title: 'Recruit adult helpers.', text: 'A few grown-ups riding along makes everyone more comfortable, especially at the front and back.' },
  { title: 'Invite families.', text: 'Spread the word at school, with neighbors, and in the community. Make it easy to just show up.' },
  { title: 'Ride, learn, and adjust.', text: 'Your first rides will teach you what works. Change stops and timing as you go.' },
];
const support = [
  'Think through a route', 'Develop stops and timing', 'Make a shareable route map',
  'Create stop and timing graphics', 'Add the route to bikebuschico.org',
  'Connect leaders with the Bike Bus Chico community', 'Share lessons from other Chico routes',
];
---
<BaseLayout title="Start a Bike Bus" description="No Bike Bus at your school yet? Here's how to start one in Chico — a simple, family-friendly sequence, with help from the Bike Bus Chico community." path="/start-a-route/">
  <section class="page-heading"><div class="wrap">
    <p class="eyebrow">Start a Bike Bus</p><h1>Your school<br />could be next.</h1>
    <p class="lede">Starting a Bike Bus is a few families deciding to ride to school together on a regular day. You don't have to figure it out alone.</p>
  </div></section>
  <section class="section"><div class="wrap">
    <h2>A simple way to begin.</h2>
    <ol class="guide-list" role="list">{steps.map((step) => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
  </div></section>
  <section class="section section-white"><div class="wrap">
    <div class="section-head"><div><p class="eyebrow">Local help</p><h2>Bike Bus Chico can help.</h2></div><p>You bring the families and the local knowledge. Bike Bus Chico can help with the rest.</p></div>
    <ul class="support">{support.map((item) => <li>{item}</li>)}</ul>
  </div></section>
  <CommunityCTA heading="We'll help you get rolling." text="Email us and we'll help you take the first step — pick a route, find families, and get set up." label="Email us about your school" href={`mailto:${site.contactEmail}`} />
</BaseLayout>
