---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommunityCTA from '../components/CommunityCTA.astro';
import RideSteps from '../components/RideSteps.astro';
const faqs = [
  { q: 'Do I need to register?', a: "No. Just show up and ride. Parents are encouraged to introduce themselves to the route leader, especially if they plan to ride regularly." },
  { q: 'Does an adult need to come?', a: 'Bike Bus Chico is a community group ride, not child care or school transportation. Families are responsible for deciding what level of adult supervision is appropriate for their child. Younger and less experienced riders should ride with an adult.' },
  { q: 'How fast do we ride?', a: 'At a kid-friendly pace. The goal is to keep the group together, not get to school as fast as possible.' },
  { q: "What if we're late?", a: "Join at a later stop if you can. Please don't rush or take risks trying to catch the group." },
  { q: 'What if my child is nervous?', a: 'Come try part of the route. Starting at a later stop is an easy way to make the first ride shorter.' },
  { q: 'What about weather or smoke?', a: "Ride leaders use judgment based on weather, air quality, route conditions, and school schedules. When conditions are questionable, check your route's Bike Bus Chico community updates or contact your ride leader before leaving home." },
];
---
<BaseLayout title="Riding With Us" description="How to ride the Bike Bus in Chico — find a route, meet at a stop, and roll with the group. No registration required." path="/ride/">
  <section class="page-heading"><div class="wrap">
    <p class="eyebrow">Ride with us</p><h1>Your first ride<br />starts here.</h1>
    <p class="lede">Come when it works for your family. Find a route, bring your bike and helmet, and meet us at a stop. You don't need to make riding to school an everyday habit to join.</p>
  </div></section>
  <section class="section"><div class="wrap">
    <RideSteps />
    <div class="content-column faq"><h2>A few good questions.</h2>
      {faqs.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
    </div>
  </div></section>
  <CommunityCTA heading="Ready to come along?" text="Find the route that works for your family and reach out to its ride leader." />
</BaseLayout>
