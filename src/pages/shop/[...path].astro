---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPrice, loadShop, type ShopData } from '../../lib/fourthwall';

export async function getStaticPaths() {
  if ((process.env.SHOP_STAGED ?? import.meta.env.SHOP_STAGED) !== '1') return [];
  const shop = await loadShop({
    FOURTHWALL_STOREFRONT_TOKEN: process.env.FOURTHWALL_STOREFRONT_TOKEN ?? import.meta.env.FOURTHWALL_STOREFRONT_TOKEN,
    FOURTHWALL_SHOP_URL: process.env.FOURTHWALL_SHOP_URL ?? import.meta.env.FOURTHWALL_SHOP_URL,
    FOURTHWALL_DAD_HAT_PRODUCT_ID: process.env.FOURTHWALL_DAD_HAT_PRODUCT_ID ?? import.meta.env.FOURTHWALL_DAD_HAT_PRODUCT_ID,
    FOURTHWALL_TEE_PRODUCT_ID: process.env.FOURTHWALL_TEE_PRODUCT_ID ?? import.meta.env.FOURTHWALL_TEE_PRODUCT_ID,
  });
  return [{ params: { path: undefined }, props: { shop } }];
}

interface Props { shop: ShopData }
const { shop } = Astro.props;
const placeholders = ['Bike Bus Chico Dad Hat', 'Ride With Us Tee'];
---
<BaseLayout title="Wear the ride." description="Official Bike Bus Chico merchandise for families, ride leaders, and supporters." path="/shop/" noindex>
  <section class="page-heading"><div class="wrap">
    <p class="eyebrow">Bike Bus Chico shop</p>
    <h1>Wear the ride.</h1>
    <p class="lede">Official Bike Bus Chico merchandise for families, ride leaders, and supporters.</p>
    <p class="notice shop-notice"><strong>Staged preview.</strong> This shop is not launched or linked in public navigation.
      {!shop.connected && ' Merchandise is coming soon; ordering is not available.'}
      {shop.connected && ' Checkout links open the real Fourthwall shop.'}
    </p>
  </div></section>
  <section class="section shop-section" aria-labelledby="merch-heading"><div class="wrap">
    <div class="section-head"><h2 id="merch-heading">For the ride.<br />And the everyday.</h2></div>
    <div class="shop-grid">
      {!shop.connected ? placeholders.map((name) => (
        <article class="panel shop-card">
          <div class="shop-placeholder">
            <span class="eyebrow">Coming soon</span>
            <p>Product photo coming soon.</p>
          </div>
          <div class="shop-card-content">
            <span class="status">Coming soon</span>
            <h3>{name}</h3>
            <p>Details, pricing, and availability will be shared when this product is ready.</p>
          </div>
        </article>
      )) : shop.products.map((product, index) => (
        <article class="panel shop-card">
          <div class="shop-image"><img src={product.image.url} width={product.image.width} height={product.image.height} alt={product.name} loading="lazy" referrerpolicy="no-referrer" /></div>
          <div class="shop-card-content">
            <span class="status">{product.available ? 'Available' : 'Sold out'}</span>
            <h3>{product.name}</h3>
            <p class="shop-price">{product.priceLabel}</p>
            {product.available ? (
              <form method="get" action={product.checkoutAction}>
                <label for={`shop-variant-${index}`}>Choose your option</label>
                <select id={`shop-variant-${index}`} name="products" required>
                  <option value="" selected disabled>Select an option</option>
                  {product.variants.map((variant) => (
                    <option value={`${variant.id}:1`} disabled={!variant.available}>
                      {variant.name} - {formatPrice(variant.price, variant.currency)}{!variant.available && ' - Sold out'}
                    </option>
                  ))}
                </select>
                <input type="hidden" name="currency" value={product.variants[0].currency} />
                <button class="button" type="submit">Checkout on Fourthwall <span aria-hidden="true">&#8599;</span></button>
                <p class="shop-checkout-note">One item per checkout. Final price, stock, shipping, and tax are confirmed by Fourthwall.</p>
              </form>
            ) : <p>This product is currently unavailable.</p>}
          </div>
        </article>
      ))}
    </div>
  </div></section>
  <section class="section section-white" aria-labelledby="shop-community-heading"><div class="wrap shop-community">
    <p class="eyebrow">More than the morning ride</p>
    <h2 id="shop-community-heading">Kids. Families.<br />Our hometown.</h2>
    <p>Bike Bus Chico brings kids and families together to ride to school, building community, confidence, and better mornings on two wheels. Local parents and volunteers help neighborhood routes get rolling.</p>
    <a class="text-link" href="/about/">Learn about Bike Bus Chico <span aria-hidden="true">&#8599;</span></a>
  </div></section>
</BaseLayout>

<style>
  .shop-notice{max-width:690px;margin-bottom:0}
  .shop-grid{display:grid;grid-template-columns:1fr;gap:24px}
  .shop-card{padding:0;overflow:hidden}
  .shop-placeholder,.shop-image{aspect-ratio:4/3;background:var(--sidewalk);display:flex;align-items:center;justify-content:center}
  .shop-placeholder{flex-direction:column;text-align:center;padding:24px;border-bottom:1px dashed var(--navy)}
  .shop-placeholder .eyebrow{margin-bottom:12px}
  .shop-placeholder p{font-size:14px;margin:0}
  .shop-image img{width:100%;height:100%;object-fit:contain}
  .shop-card-content{padding:24px}
  .shop-card h3{color:var(--blue);margin:18px 0 16px;font-size:34px;overflow-wrap:anywhere}
  .shop-card p{font-size:14px}
  .shop-card-content>p:last-child{margin-bottom:0}
  .shop-price{font-family:var(--label);font-weight:800}
  .shop-card label{display:block;font-size:14px;margin-bottom:8px}
  .shop-card select{font:inherit;font-size:14px;color:var(--navy);background:white;border:1px solid var(--navy);border-radius:7px;min-height:48px;width:100%;padding:10px;margin-bottom:18px}
  .shop-card select:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
  .shop-card .button{width:100%}
  .shop-checkout-note{font-size:12px!important;margin:14px 0 0}
  .shop-community{max-width:850px}
  .shop-community h2{margin-bottom:24px}
  .shop-community>p:not(.eyebrow){max-width:690px}
  @media(min-width:761px){
    .shop-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .shop-card-content{padding:30px}
  }
</style>
