---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { canPurchaseProduct, canViewProductDetails, formatShopPrice, orderShopProducts, shopProducts, validateShopProducts, type ShopProduct } from '../../data/shop';

export function getStaticPaths() {
  if ((process.env.SHOP_STAGED ?? import.meta.env.SHOP_STAGED) !== '1') return [];
  validateShopProducts(shopProducts);
  return [{ params: { path: undefined }, props: { products: orderShopProducts(shopProducts) } }];
}

interface Props { products: readonly ShopProduct[] }
const { products } = Astro.props;
const hasPurchaseLinks = products.some(canPurchaseProduct);
const hasProductLinks = products.some(canViewProductDetails);
const allComingSoon = products.every((product) => product.status === 'coming_soon');
---
<BaseLayout title="Wear the ride." description="Bike Bus Chico gear for kids, families, ride leaders, and supporters. Made for the school ride and wherever the road takes you." path="/shop/" noindex>
  <section class="page-heading shop-heading"><div class="wrap">
    <p class="eyebrow">Bike Bus Chico shop</p>
    <h1>Wear the ride.</h1>
    <p class="lede">Bike Bus Chico gear for kids, families, ride leaders, and supporters. Made for the school ride and wherever the road takes you.</p>
    <p class="notice shop-notice"><strong>Staged preview.</strong> This shop is not launched or linked in public navigation.
      {!hasPurchaseLinks && (allComingSoon ? ' Products are coming soon; purchase buttons are not enabled.' : ' Purchase buttons are not enabled in this preview.')}
      {hasPurchaseLinks && ' Choose options and buy in our Printify Pop-Up Store.'}
    </p>
  </div></section>
  <section class="section shop-section" aria-labelledby="merch-heading"><div class="wrap">
    <h2 class="sr-only" id="merch-heading">Bike Bus Chico merchandise</h2>
    <div class="shop-grid">
      {products.map((product) => {
        const purchasable = canPurchaseProduct(product);
        const linked = canViewProductDetails(product);
        const CardContent = linked ? 'a' : 'div';
        return (
        <article class="panel shop-card">
          <CardContent class="shop-card-body" href={linked ? product.productUrl : undefined} rel={linked ? 'external' : undefined} aria-label={linked ? `${purchasable ? 'Choose options & buy' : 'View details for'} ${product.name} on Printify` : undefined}>
          {product.image ? (
            <div class="shop-image"><img src={product.image.src} width={product.image.width} height={product.image.height} alt={product.image.alt} loading="lazy" referrerpolicy="no-referrer" /></div>
          ) : (
            <div class="shop-placeholder">
              <span class="eyebrow">{product.status === 'coming_soon' ? 'Coming soon' : 'Photo pending'}</span>
              <p>Product photo coming soon.</p>
            </div>
          )}
          <div class="shop-card-content">
            <span class="status">{{ coming_soon: 'Coming soon', available: 'Available', 'sold-out': 'Sold out' }[product.status]}</span>
            <h3>{product.name}</h3>
            <p class="shop-category">{product.category}</p>
            <p>{product.description}</p>
            {product.priceVerified && product.price && <div class="shop-pricing">
              <p class="shop-price">{formatShopPrice(product.price)}</p>
              <p class="shop-shipping">Shipping calculated at checkout</p>
            </div>}
            {linked && (
              <span class:list={['button', 'shop-action', { 'shop-buy': purchasable }]}>{purchasable ? 'Choose options & buy' : 'View details'} <span aria-hidden="true">&#8599;</span></span>
            )}
          </div>
          </CardContent>
        </article>
        );
      })}
    </div>
    {hasProductLinks && <p class="shop-checkout-note">Product details open in our Printify Pop-Up Store. {hasPurchaseLinks ? 'Choose your options and complete your purchase there.' : allComingSoon ? 'Products are currently coming soon; ordering is not yet available.' : 'Purchase buttons are not enabled in this preview; check product availability there.'} Printify handles options, cart, payments, and fulfillment when purchasing is enabled. No Bike Bus Chico website account is needed. Final prices, availability, shipping, and tax are confirmed there.</p>}
  </div></section>
  <section class="section section-white" aria-labelledby="shop-community-heading"><div class="wrap shop-community">
    <p class="eyebrow">More than the morning ride</p>
    <h2 id="shop-community-heading">More than merchandise.</h2>
    <p>We're building a community where more kids can ride to school safely, confidently, and together. Wearing Bike Bus Chico gear helps spread the word.</p>
    <a class="text-link" href="/about/">Learn about Bike Bus Chico <span aria-hidden="true">&#8599;</span></a>
  </div></section>
</BaseLayout>

<style>
  .shop-heading{padding-bottom:20px}
  .shop-heading + .shop-section{padding-top:0}
  .shop-notice{max-width:690px;margin-bottom:0}
  .shop-grid{display:grid;grid-template-columns:1fr;gap:24px}
  .shop-card{padding:0;overflow:hidden}
  .shop-card-body{display:flex;flex-direction:column;height:100%}
  a.shop-card-body:focus-visible{outline:3px solid var(--blue);outline-offset:-3px;border-radius:13px}
  .shop-placeholder,.shop-image{aspect-ratio:4/3;background:var(--sidewalk);display:flex;align-items:center;justify-content:center}
  .shop-placeholder{flex-direction:column;text-align:center;padding:24px;border-bottom:1px dashed var(--navy)}
  .shop-placeholder .eyebrow{margin-bottom:12px}
  .shop-placeholder p{font-size:14px;margin:0}
  .shop-image img{width:100%;height:100%;object-fit:contain}
  .shop-card-content{padding:24px;display:flex;flex-direction:column;flex:1}
  .shop-card .status{align-self:flex-start}
  .shop-card h3{color:var(--blue);margin:18px 0 16px;font-size:34px;overflow-wrap:anywhere}
  .shop-card p{font-size:14px}
  .shop-card .shop-category{font-size:12px;font-family:var(--label);margin-top:-8px}
  .shop-card-content>p:last-child{margin-bottom:0}
  .shop-pricing{margin-top:auto}
  .shop-price{font-family:var(--label);font-weight:800;margin-bottom:4px}
  .shop-card .shop-shipping{font-size:12px;margin-bottom:0}
  .shop-card .button{width:100%}
  .shop-action{margin-top:20px}
  .shop-checkout-note{font-size:12px;margin:18px 0 0}
  .shop-community{max-width:850px}
  .shop-community h2{margin-bottom:24px}
  .shop-community>p:not(.eyebrow){max-width:690px}
  @media(min-width:761px){
    .shop-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .shop-card-content{padding:30px}
  }
  @media(min-width:1101px){
    .shop-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
  }
</style>
