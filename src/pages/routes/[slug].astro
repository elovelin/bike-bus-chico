---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityCTA from '../../components/CommunityCTA.astro';
import RouteFacts from '../../components/RouteFacts.astro';
import RouteStatus from '../../components/RouteStatus.astro';
import { site } from '../../data/site';
import { routes, type Route } from '../../data/routes';
export function getStaticPaths() {
  return routes.map((route) => ({ params: { slug: route.slug }, props: { route } }));
}
interface Props { route: Route }
const { route } = Astro.props;
const neighborhood = route.name.split(' → ')[0];
const hasPdf = route.routePdf && fs.existsSync(path.join(process.cwd(), 'public', route.routePdf));
const contact = site.contactEmail;
const startingSoon = route.status === 'forming';
---
<BaseLayout title={route.name} description={route.summary} path={`/routes/${route.slug}/`}>
  <section class="page-heading"><div class="wrap">
    <a class="crumb" href={`/schools/${route.schoolSlug}/`}>&larr; {route.school} routes</a>
    <p class="eyebrow">{route.school}</p><h1>{route.name.includes(' → ') ? <>{neighborhood}<br />to school.</> : route.name}</h1>
    <p class="lede">{route.summary}</p>
    {startingSoon && <p class="notice"><strong>Starting soon — not yet running.</strong> No first ride date has been announced. The schedule below is planned, not a currently operating service.</p>}
  </div></section>
  <section class="section"><div class="wrap detail-layout">
    <div class="panel">
      <h2>{startingSoon ? 'The planned ride.' : 'Your stops.'}</h2>
      {route.scheduleNote && <p>{route.scheduleNote}</p>}
      <ol class="stop-list" role="list">
        {route.stops.map((stop, index) => (
          <li class="stop"><span class="stop-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><strong>{stop.name}</strong>{stop.note && <p>{stop.note}</p>}</div>{stop.time && <span class="stop-time">{stop.time}</span>}</li>
        ))}
      </ol>
      {route.joinLocations && <section class="join-locations"><h2>Join along the way.</h2><p>Students can join the neighborhood ride at these locations along the route:</p><ul>{route.joinLocations.map((location) => <li>{location}</li>)}</ul><p>Intermediate meeting times have not been announced.</p></section>}
      {!startingSoon && <p class="notice">Please arrive a few minutes early. The Bike Bus won't leave a listed stop before its scheduled time.</p>}
      {route.mapImage && (
        <section class="static-map" aria-labelledby="route-map-heading">
          <h2 id="route-map-heading">Your route map.</h2>
          <a class="map-link" href={route.mapImage} target="_blank" rel="noopener noreferrer">
            <img src={route.mapImage} alt={route.mapAlt ?? `Map of the ${route.name} Bike Bus route`} width={route.mapWidth} height={route.mapHeight} loading="lazy" />
            <span>Open the route map in full size <span aria-hidden="true">&#8599;</span><span class="sr-only"> (opens in a new tab)</span></span>
          </a>
          <a class="text-link map-download" href={route.mapImage} download>Download route map (PNG)</a>
        </section>
      )}
      {hasPdf && <a class="text-link map-download" href={route.routePdf}>Download printable route (PDF)</a>}
    </div>
    <aside class="detail-side" aria-label="Ride details">
      <div class="panel"><RouteStatus status={route.status} /><RouteFacts route={route} />{route.arrivalTime && <p class="arrival">Arrival at {route.school}: {route.arrivalTime}</p>}</div>
      {!startingSoon && <div class="panel">
        <h2>{route.leaderName ? 'Meet your ride leader.' : 'Come ride with us.'}</h2>
        {route.leaderName ? <><p class="lede">{route.leaderName}</p><p>Ask a question, introduce your family, or let your ride leader know you're planning to join.</p></> : <p>This route is running. Contact Bike Bus Chico to connect with the crew.</p>}
        <a class="button" href={`mailto:${contact}`}>Email Bike Bus Chico <span aria-hidden="true">&#8599;</span></a>
      </div>}
      <div class="panel">
        <h2>Before you go.</h2>
        <p>Bring a working bike and helmet. Arrive at your stop a few minutes early. Younger and less experienced riders should ride with an adult.</p>
        <a class="text-link" href="/ride/">Your first ride <span aria-hidden="true">&#8599;</span></a>
      </div>
      <div class="panel weekly-ride">
        <h2>This week's ride.</h2>
        {startingSoon ? <p>This ride has not started yet. The Friday schedule is planned; the first ride date has not been announced.</p> : <p>Weather, air quality, and school schedules can change a ride. Day-to-day coordination happens in our community Discord (invite-only for now). Reach out to get connected before your first ride.</p>}
        <a class="text-link" href={`mailto:${contact}`}>Check with the crew <span aria-hidden="true">&#8599;</span></a>
        <section class="live-map-link" aria-labelledby="live-map-heading">
          <h3 id="live-map-heading">Live map</h3>
          <a class="text-link" href={route.mapViewerUrl ?? site.routeMapViewerUrl} target="_blank" rel="noopener noreferrer">Open live map<span class="sr-only"> for {route.name} to {route.school}</span> <span aria-hidden="true">&#8599;</span><span class="sr-only"> (opens in a new tab)</span></a>
        </section>
      </div>
    </aside>
  </div></section>
  <CommunityCTA heading={startingSoon ? 'Get ready for your first ride.' : 'See you on the ride.'} text={startingSoon ? 'Learn what to bring and how we ride while this neighborhood Bike Bus gets ready to roll.' : 'Come ride this route, connect with the community, or start a Bike Bus at your own school.'} label={startingSoon ? 'Your first ride' : undefined} href={startingSoon ? '/ride/' : undefined} />
</BaseLayout>
<style>
  .join-locations { margin-top: 32px; }
  .live-map-link { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--sidewalk); }
  .live-map-link h3 { font-size: 23px; margin-bottom: 10px; }
</style>
