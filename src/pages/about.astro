---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommunityCTA from '../components/CommunityCTA.astro';
const values = [
  { title: 'Joy', text: 'Kids should look forward to the trip.' },
  { title: 'Community', text: 'A Bike Bus connects families and neighborhoods.' },
  { title: 'Confidence', text: 'Kids learn that bikes can be transportation, not just recreation.' },
  { title: 'Access', text: 'More Chico families should have a practical opportunity to participate in active transportation.' },
];
---
<BaseLayout title="About" description="Bike Bus Chico is a community-led effort to help Chico families ride to school together." path="/about/">
  <section class="page-heading"><div class="wrap">
    <p class="eyebrow">About Bike Bus Chico</p><h1>Kids. Families.<br />Our hometown.</h1>
    <p class="lede">Bike Bus Chico brings kids and families together to ride to school as a group, building community, confidence, and better mornings on two wheels.</p>
  </div></section>
  <section class="section section-white"><div class="wrap about-layout">
    <div>
      <h2>A school bus.<br />Powered by us.</h2>
      <p>The idea is simple: the morning trip to school can be more than a car line. It can be exercise, independence, friendship, music, fresh air, and a chance to experience Chico at bike speed.</p>
      <p>Like a school bus, we have a route, stops, and a schedule. Families can meet at the beginning or join along the way.</p>
      <p>Our rides are organized by local parents and volunteers. As more families and schools become interested, Bike Bus Chico helps new neighborhood routes get rolling.</p>
      <p>Bike Bus Chico is a community group ride, not child care or school transportation. Families are responsible for appropriate supervision.</p>
      <a class="text-link" href="/ride/">How riding with us works <span aria-hidden="true">&#8599;</span></a>
    </div>
    <img src="/photos/hero.jpg" alt="Bike Bus Chico families riding together in Chico" loading="lazy" />
  </div></section>
  <section class="section"><div class="wrap">
    <div class="section-head"><h2>What we care about.</h2></div>
    <div class="values">{values.map((value) => <article class="panel"><h3>{value.title}</h3><p>{value.text}</p></article>)}</div>
    <p class="community-note">More families on bikes means fewer cars competing for space around school at drop-off. Building community, reducing traffic, and creating healthy habits — one ride at a time.</p>
  </div></section>
  <CommunityCTA />
</BaseLayout>
